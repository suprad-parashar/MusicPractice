{
  "name": "carnaticpractice",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "generate:compositions": "node scripts/generate-composition-registry.mjs",
    "predev": "npm run generate:compositions",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "npm run generate:compositions",
    "build": "next build",
    "start": "NODE_ENV=production node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "@fontsource/bravura": "^5.2.5",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "next": "^16.3.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "soundfont-player": "^0.12.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tonejs/midi": "^2.0.28",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
